*{box-sizing:border-box}body{margin:0;font-family:system-ui,-apple-system,Segoe UI,Roboto,sans-serif;color:#1a1a1a;background:#fafafa;line-height:1.6}
header{background:#111;color:#fff;padding:18px 24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:10px}
header a{color:#fff;text-decoration:none;margin-left:18px;font-size:15px}header .logo{font-weight:700;font-size:20px;margin:0}
main{max-width:820px;margin:0 auto;padding:40px 24px}h1{font-size:32px;margin-top:0}h2{margin-top:32px;font-size:20px}
.hero{text-align:center;padding:40px 0}.hero p{font-size:18px;color:#444}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px;margin-top:30px}
.card{background:#fff;border:1px solid #e5e5e5;border-radius:10px;padding:20px}footer{text-align:center;font-size:14px;color:#666;padding:30px 24px;border-top:1px solid #e5e5e5}
footer a{color:#666;margin:0 8px}.small{color:#666;font-size:14px}
